import javafx.application.Application;
import javafx.geometry.Insets;
import javafx.geometry.Pos;
import javafx.scene.Scene;
import javafx.scene.control.*;
import javafx.scene.layout.*;
import javafx.stage.Stage;

public class FoodieGoodieMenu extends Application {

    private BorderPane root;
    private VBox cartItemsBox;

    @Override
    public void start(Stage stage) {

        root = new BorderPane();

        // ================= SIDE MENU =================
        VBox sideMenu = new VBox(15);
        sideMenu.setPadding(new Insets(15));
        sideMenu.setPrefWidth(180);

        Label menuTitle = new Label("FOODIE GOODIE");
        menuTitle.setStyle("-fx-font-size:18px; -fx-font-weight:bold;");

        Button dashboardBtn = new Button("Dashboard");
        Button menuBtn = new Button("Menu");
        Button cartBtn = new Button("Cart");

        dashboardBtn.setMaxWidth(Double.MAX_VALUE);
        menuBtn.setMaxWidth(Double.MAX_VALUE);
        cartBtn.setMaxWidth(Double.MAX_VALUE);

        sideMenu.getChildren().addAll(
                menuTitle,
                dashboardBtn,
                menuBtn,
                cartBtn
        );

        root.setLeft(sideMenu);
//shima
// Button Actions
        dashboardBtn.setOnAction(e -> showDashboard());
        menuBtn.setOnAction(e -> showMenu());
        cartBtn.setOnAction(e -> showCart());

        // Default Page
        showDashboard();

        Scene scene = new Scene(root, 900, 600);

        stage.setTitle("Foodie Goodie Restaurant");
        stage.setScene(scene);
        stage.show();
    }

    // ================= DASHBOARD =================
    private void showDashboard() {

        VBox dashboard = new VBox(15);
        dashboard.setPadding(new Insets(20));

        Label title = new Label("Restaurant Dashboard");
        title.setStyle("-fx-font-size:22px; -fx-font-weight:bold;");

        Label name = new Label("Restaurant Name : Foodie Goodie");
        Label location = new Label("Location : Rangpur, Bangladesh");
        Label welcome = new Label("Welcome to Foodie Goodie Restaurant");

        dashboard.getChildren().addAll(
                title,
                name,
                location,
                welcome
        );

        root.setCenter(dashboard);
    }

    // ================= MENU PAGE =================
    private void showMenu() {

        VBox mainBox = new VBox(15);
        mainBox.setPadding(new Insets(15));

        Label title = new Label("Restaurant Menu");
        title.setStyle("-fx-font-size:20px; -fx-font-weight:bold;");

        GridPane grid = new GridPane();
        grid.setHgap(20);
        grid.setVgap(20);

        String[] foods = {
                "Burger",
                "Pizza",
                "Chicken Fry",
                "Pasta",
                "Coffee",
                "Sandwich"
        };

        String[] prices = {
                "250 Tk",
                "450 Tk",
                "300 Tk",
                "280 Tk",
                "120 Tk",
                "150 Tk"
        };

        int item = 0;

        for (int row = 0; row < 3; row++) {

            for (int col = 0; col < 2; col++) {

                VBox card = new VBox(10);
                card.setAlignment(Pos.CENTER);
                card.setPadding(new Insets(10));

                card.setStyle(
                        "-fx-border-color:black;" +
                        "-fx-border-width:1;"
                );

                Label foodName = new Label(foods[item]);
                Label foodPrice = new Label(prices[item]);

                Button addButton = new Button("Add To Cart");

                String food = foods[item];

                addButton.setOnAction(e -> {
                    Alert alert = new Alert(Alert.AlertType.INFORMATION);
                    alert.setHeaderText(null);
                    alert.setContentText(food + " added to cart");
                    alert.showAndWait();
                });

                card.getChildren().addAll(
                        foodName,
                        foodPrice,
                        addButton
                );

                grid.add(card, col, row);

                item++;
            }
        }

        mainBox.getChildren().addAll(title, grid);

        root.setCenter(mainBox);
    }
//asma
// Layout
        VBox root = new VBox(10);
        root.setPadding(new Insets(15));

        root.getChildren().addAll(
                restaurantName,
                menuTitle,
                burger,
                pizza,
                friedRice,
                chickenFry,
                coke,
                iceCream,
                orderButton,
                orderSummary
        );
//-----------CART PAGE----------------
private void showCart() {

        VBox cartPage = new VBox(15);
        cartPage.setPadding(new Insets(20));

        Label title = new Label("Cart Management");
        title.setStyle("-fx-font-size:20px; -fx-font-weight:bold;");

        TextField itemField = new TextField();
        itemField.setPromptText("Enter New Item");

        TextField priceField = new TextField();
        priceField.setPromptText("Enter Price");

        Button addItemBtn = new Button("Add Item");
        Button updatePriceBtn = new Button("Update Price");

        cartItemsBox = new VBox(10);

        addItemBtn.setOnAction(e -> {

            String item = itemField.getText();
            String price = priceField.getText();

            if (!item.isEmpty() && !price.isEmpty()) {

                Label newItem =
                        new Label(item + " - " + price + " Tk");

                cartItemsBox.getChildren().add(newItem);

                itemField.clear();
                priceField.clear();
            }
        });

//nova
updatePriceBtn.setOnAction(e -> {

            Alert alert = new Alert(Alert.AlertType.INFORMATION);
            alert.setHeaderText(null);
            alert.setContentText("Price Updated Successfully");
            alert.showAndWait();
        });

        cartPage.getChildren().addAll(
                title,
                itemField,
                priceField,
                addItemBtn,
                updatePriceBtn,
                new Separator(),
                new Label("Selected Items:"),
                cartItemsBox,
                new Separator(),
                totalBillLabel
        );

        root.setCenter(cartPage);
    }

    public static void main(String[] args) {
        launch(args);
    }
}



























































