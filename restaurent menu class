// Button Action
        orderButton.setOnAction(e -> {

            int total = 0;
            StringBuilder summary = new StringBuilder();

            summary.append("===== FOODIE GOODIE =====\n");
            summary.append("Order Summary\n\n");

            if (burger.isSelected()) {
                total += 250;
                summary.append("Burger - 250 Tk\n");
            }

            if (pizza.isSelected()) {
                total += 600;
                summary.append("Pizza - 600 Tk\n");
            }

            if (friedRice.isSelected()) {
                total += 300;
                summary.append("Fried Rice - 300 Tk\n");
            }

            if (chickenFry.isSelected()) {
                total += 180;
                summary.append("Chicken Fry - 180 Tk\n");
            }

            if (coke.isSelected()) {
                total += 40;
                summary.append("Coke - 40 Tk\n");
            }

            if (iceCream.isSelected()) {
                total += 100;
                summary.append("Ice Cream - 100 Tk\n");
            }

            summary.append("\n-------------------------\n");
            summary.append("Total Bill = ");
            summary.append(total);
            summary.append(" Tk");

            orderSummary.setText(summary.toString());
        });
